# Supabase
# Copy this file to `.env.local` and fill in the values from your Supabase
# project settings (Project Settings -> API). Do NOT commit `.env.local`.

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase project's public anon key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
